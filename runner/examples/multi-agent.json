{
  "agents": [
    {
      "name": "Codex CLI",
      "model": "codex-cli",
      "version": "local",
      "adapter": "command",
      "command": "codex",
      "args": [
        "--sandbox",
        "workspace-write",
        "--ask-for-approval",
        "never",
        "exec",
        "--json",
        "--ephemeral",
        "--skip-git-repo-check",
        "-"
      ],
      "stdin": "prompt",
      "output": "jsonl",
      "timeoutSeconds": 300
    },
    {
      "name": "DeepSeek Harness",
      "model": "deepseek-harness",
      "version": "local",
      "adapter": "command",
      "command": "replace-with-deepseek-harness-executable",
      "args": ["replace-with-non-interactive-arguments"],
      "stdin": "prompt",
      "output": "jsonl",
      "timeoutSeconds": 300
    }
  ]
}
