{
  "schema_version": "forkskinny64_spec_v1",
  "state": {
    "cell_width_bits": 4,
    "cell_count": 16,
    "indexing": "row-major: index = 4*row + column",
    "value_range": "0..15"
  },
  "round_function": {
    "round_count": 14,
    "operation_order": [
      "SubCells",
      "AddConstants",
      "AddRoundTweakey",
      "ShiftRows",
      "MixColumns"
    ],
    "sbox": [12, 6, 9, 0, 1, 10, 2, 11, 3, 8, 5, 13, 4, 14, 7, 15],
    "round_constants": [
      1, 3, 7, 15, 31, 62, 61, 59, 55, 47,
      30, 60, 57, 51, 39, 14, 29, 58, 53, 43,
      22, 44, 24, 48, 33, 2, 5, 11, 23, 46,
      28, 56, 49, 35, 6, 13, 27, 54, 45, 26, 52
    ],
    "add_constants": {
      "cell_0": "state[0] XOR= RC[r] & 0xf",
      "cell_4": "state[4] XOR= (RC[r] >> 4) & 0x3",
      "cell_8": "state[8] XOR= 0x2"
    },
    "add_round_tweakey": "XOR round_tweakey[key_index][0..7] into state[0..7]",
    "shift_rows": {
      "source_index_for_each_destination": [0, 1, 2, 3, 7, 4, 5, 6, 10, 11, 8, 9, 13, 14, 15, 12],
      "exact_assignment": "for every destination d in 0..15: new_state[d] = old_state[source_index_for_each_destination[d]]"
    },
    "mix_columns": {
      "per_column_input": "(a,b,c,d) = (state[col], state[col+4], state[col+8], state[col+12])",
      "per_column_output": "(a XOR c XOR d, a, b XOR c, a XOR c)"
    }
  },
  "tweakey_schedule": {
    "branches": ["TK1", "TK2", "TK3"],
    "round_tweakey": "round_tweakey[r][i] = TK1_r[i] XOR TK2_r[i] XOR TK3_r[i] for i=0..7",
    "update_after_each_round_except_last": {
      "permutation": {
        "source_index_for_each_destination": [9, 15, 8, 13, 10, 14, 12, 11, 0, 1, 2, 3, 4, 5, 6, 7],
        "exact_assignment": "for every destination d in 0..15 and each TK branch: new_tk[d] = old_tk[source_index_for_each_destination[d]]"
      },
      "tk1_upper_cells": "no LFSR after permutation",
      "tk2_upper_cells": "for i=0..7: ((x << 1) XOR ((x >> 3) & 1) XOR ((x >> 2) & 1)) & 0xf",
      "tk3_upper_cells": "for i=0..7: ((x >> 1) XOR (((x XOR (x >> 3)) & 1) << 3)) & 0xf"
    },
    "generated_round_tweakeys": 41
  },
  "fork_selection": {
    "fork_round": 7,
    "c0_branch_length": 27,
    "key_index_for_encryption_round_r": "r if r < 7, otherwise r + 27",
    "round_indexing": "r is zero-based and ranges from 0 to 13"
  }
}
