<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cryptobench.benchmark.persistence.RawSqlMapper">
    <!-- SQL 由仓储层提供，所有动态值仍通过 params 的 #{} 占位符绑定。 -->
    <select id="select" resultType="map">
        ${sql}
    </select>
    <update id="update">
        ${sql}
    </update>
</mapper>
