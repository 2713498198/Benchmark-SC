<configuration>
  <conversionRule conversionWord="desktopSafe" converterClass="com.cryptobench.desktop.DesktopRedactionConverter"/>
  <springProperty scope="context" name="LOG_FILE" source="logging.file.name"/>
  <appender name="DESKTOP" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>200MB</totalSizeCap>
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{48} - %nopex%desktopSafe(%msg%n%ex)</pattern>
    </encoder>
  </appender>
  <root level="INFO"><appender-ref ref="DESKTOP"/></root>
</configuration>
