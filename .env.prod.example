# Production deployment variables loaded with
# `docker compose --env-file .env.prod -f compose.prod.yaml`.
# Copy to `.env.prod` and fill in real values; never commit `.env.prod`.

# Public domain served by Caddy. Must resolve to this host before first start.
DOMAIN=cryptobench.example.com
CRYPTOBENCH_IMAGE=cryptobench:1.1.0

# MySQL credentials. MYSQL_ROOT_PASSWORD is used only for the container init
# and healthcheck; the application uses DB_USERNAME/DB_PASSWORD.
MYSQL_ROOT_PASSWORD=change-this-root-password
DB_USERNAME=cryptobench
DB_PASSWORD=change-this-app-password

# Per-user and global run quotas. Reduce these for a public deployment.
CRYPTOBENCH_RUN_MAX_ACTIVE_PER_USER=2
CRYPTOBENCH_RUN_MAX_CREATED_PER_DAY_PER_USER=10
CRYPTOBENCH_RUN_MAX_ACTIVE_GLOBAL=100

# Optional one-time first administrator. Set all three for the first startup,
# then remove them and `docker compose up -d --force-recreate app`.
# Optional mail delivery. Use an SMTP provider for real email; keep mode=auto
# only if a gateway/outbox is intentionally configured elsewhere.
# CRYPTOBENCH_MAIL_MODE=smtp
# CRYPTOBENCH_SMTP_HOST=smtp.example.com
# CRYPTOBENCH_SMTP_PORT=465
# CRYPTOBENCH_SMTP_USERNAME=sender@example.com
# CRYPTOBENCH_SMTP_PASSWORD=change-this-smtp-password
# CRYPTOBENCH_MAIL_FROM=sender@example.com
# CRYPTOBENCH_SMTP_STARTTLS=false
# CRYPTOBENCH_SMTP_SSL=true

# Password reset links. Defaults to https://${DOMAIN}; override only if the
# public origin differs from the Caddy domain.
