# Reference only: Spring Boot does not load .env files automatically.
# Set these variables in IDEA Run Configuration or PowerShell.
SPRING_PROFILES_ACTIVE=local
PORT=4173
SERVER_ADDRESS=127.0.0.1

# For prod profile (MySQL 8+), create the cryptobench database first.
# DB_URL=jdbc:mysql://127.0.0.1:3306/cryptobench?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
# DB_USERNAME=cryptobench
# DB_PASSWORD=
# SECURE_COOKIE=true

# Optional, one-time import from the previous Node JSON database into an empty DB.
# LEGACY_IMPORT_ENABLED=true
# CRYPTOBENCH_DB_FILE=D:/develop/Benchmark/data/runtime/db.json
