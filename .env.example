# Docker Compose reads .env for interpolation, but only variables explicitly
# mapped in compose.yaml enter the container. See docker/README.md.
HOST_PORT=4173
CRYPTOBENCH_DATA_DIR=./var
CRYPTOBENCH_COMPOSE_DEMO_ENABLED=false

# By default Compose uses its project name as the stable resource isolation ID.
# Override only when needed; independently running installations need distinct IDs.
# CRYPTOBENCH_INSTANCE_ID=cryptobench-my-instance
# Optional Docker model gateway. Provider definitions contain NO user API keys.
CRYPTOBENCH_GATEWAY_ENABLED=false
CRYPTOBENCH_GATEWAY_PROVIDERS=[]
# Replace these example public routes and model IDs before enabling the gateway:
# CRYPTOBENCH_GATEWAY_PROVIDERS='[{"id":"example","name":"Example provider","baseUrl":"https://your-provider.example/v1","models":["provider-model-id"],"priceModelIds":{"provider-model-id":"model-id-in-price-table"}}]'
# CRYPTOBENCH_GATEWAY_IMAGE=cryptobench-model-gateway:local

# Direct Spring Boot / start.cmd does NOT load .env automatically.
# Set the following in IDEA Run Configuration or PowerShell for source startup.
# Compose fixes its own profile, internal port/address and persistent DB URL.
SPRING_PROFILES_ACTIVE=local
PORT=4173
SERVER_ADDRESS=127.0.0.1

# Optional one-time first administrator bootstrap. Set all three for one startup,
# then remove all three and recreate the Compose website container.
# Use an unused real email, not admin@cryptobench.local/researcher@cryptobench.local.
# Choose a password of 8-24 characters. Existing accounts are never overwritten.
# CRYPTOBENCH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# CRYPTOBENCH_BOOTSTRAP_ADMIN_NAME=Platform Admin
# CRYPTOBENCH_BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# For direct prod startup (MySQL 8+), create the database first.
# These DB settings do not replace the local Compose file database.
# DB_URL=jdbc:mysql://127.0.0.1:3306/cryptobench?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
# DB_USERNAME=cryptobench
# DB_PASSWORD=
# SECURE_COOKIE=true

# Optional password reset delivery. Use an internal mail gateway in shared environments;
# for local testing, write reset messages to a non-public JSONL file instead.
# PASSWORD_RESET_DELIVERY_URL=http://127.0.0.1:8090/mail
# PASSWORD_RESET_OUTBOX=D:/Benchmark-SC2/Benchmark-SC/var/mail/password-reset.jsonl
# PASSWORD_RESET_BASE_URL=http://127.0.0.1:4173

# Reliable mail delivery. SMTP requires an explicit mode and provider app password.
# The existing gateway/outbox configuration remains available with mode=auto.
# CRYPTOBENCH_MAIL_MODE=smtp
# CRYPTOBENCH_MAIL_KEY_FILE=var/secrets/mail.key
# CRYPTOBENCH_SMTP_HOST=smtp.qq.com
# CRYPTOBENCH_SMTP_PORT=465
# CRYPTOBENCH_SMTP_USERNAME=sender@example.com
# CRYPTOBENCH_SMTP_PASSWORD=
# CRYPTOBENCH_MAIL_FROM=sender@example.com
# CRYPTOBENCH_SMTP_STARTTLS=false
# CRYPTOBENCH_SMTP_SSL=true
# Production requires a provisioned, persistent encryption key file; see docs/mail-delivery.md.

# Optional, one-time import from the previous Node JSON database into an empty DB.
# LEGACY_IMPORT_ENABLED=true
# CRYPTOBENCH_DB_FILE=D:/develop/Benchmark/data/runtime/db.json
