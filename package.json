{
  "name": "cryptobench-frontend-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "agent:mock": "node tests/fixtures/mock-agent.mjs",
    "vendor:vue": "node scripts/sync-vue.mjs",
    "check": "node tests/check.mjs && node tests/vue-templates.mjs",
    "validate:evaluator": "node scripts/validate-evaluator-catalog.mjs src/main/resources/evaluation/mini-spn/1.0.0/tasks.json mini-spn 1.0.0",
    "validate:v4-materials": "node scripts/validate-v4-materials.mjs",
    "test:evaluator": "node tests/evaluator-catalog.mjs",
    "test:v4-materials": "node tests/v4-materials.mjs",
    "test": "node tests/smoke.mjs",
    "test:design": "node tests/redesign.mjs",
    "test:docker": "node tests/docker-integration.mjs",
    "test:docker:e2e": "node tests/docker-platform-e2e.mjs",
    "test:compose": "node tests/compose-smoke.mjs",
    "test:compose:sandbox": "node tests/compose-sandbox-smoke.mjs",
    "test:docker-ui": "node tests/docker-ui-browser.mjs",
    "test:desktop": "node tests/windows-app-image.mjs",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:windows:installer": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1 -Installer"
  },
  "dependencies": {
    "vue": "3.5.22"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
